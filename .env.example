# Copy to .env.properties at the repo root and fill in real values.
# Spring Boot imports this file via application.yml (spring.config.import).
# Docker Compose: also symlink or copy to `.env` (Compose reads `.env` for ${db_*} interpolation),
# or run: docker compose --env-file .env.properties up -d db
#
# Local DB host port: 5433 (maps to container 5432). Native Postgres often uses 5432.

db_name=ewallet
db_username=postgres
db_password=CHANGE_ME_STRONG_DB_PASSWORD
jwt_secret=CHANGE_ME_AT_LEAST_64_CHAR_RANDOM_SECRET_FOR_HS512_ALGORITHM_XXXXXXXX

# Comma-separated browser origins allowed for CORS (no trailing slash).
# Local: http://localhost:3000 (and :3001 if CRA falls back when :3000 is busy)
# Prod: https://your-frontend.example.com
cors_allowed_origins=http://localhost:3000,http://localhost:3001
