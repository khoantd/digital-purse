# Copy to .env.properties at the repo root and fill in real values.
# Spring Boot imports this file via application.yml (spring.config.import).
# Docker Compose (db service) also reads this file via env_file.

db_name=ewallet
db_username=postgres
db_password=CHANGE_ME_STRONG_DB_PASSWORD
jwt_secret=CHANGE_ME_AT_LEAST_64_CHAR_RANDOM_SECRET_FOR_HS512_ALGORITHM_XXXXXXXX

# Comma-separated browser origins allowed for CORS (no trailing slash).
# Local: http://localhost:3000
# Prod: https://your-frontend.example.com
cors_allowed_origins=http://localhost:3000
